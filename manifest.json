{
    "manifest_version": 3,
    "name": "Coursera Autopilot Pro",
    "version": "2.4",
    "description": "All-in-one automation suite for Coursera: Safe-Skip, Smart AI Quiz & Peer Review.",
    "permissions": [
        "activeTab",
        "scripting",
        "declarativeNetRequest",
        "storage",
        "clipboardWrite"
    ],
    "host_permissions": [
        "*://*.coursera.org/*",
        "https://generativelanguage.googleapis.com/*",
        "https://api.groq.com/*",
        "https://openrouter.ai/*",
        "https://api.openai.com/*"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "assets/icon16.png",
            "48": "assets/icon48.png",
            "128": "assets/icon128.png"
        }
    },
    "icons": {
        "16": "assets/icon16.png",
        "48": "assets/icon48.png",
        "128": "assets/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.coursera.org/*"
            ],
            "js": [
                "inject.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "*://*.coursera.org/*",
                "*://coursera.org/*"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": true
        }
    ]
}