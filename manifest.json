{
    "manifest_version": 3,
    "name": "Coursera Skipper Pro",
    "version": "2.0",
    "description": "Auto-skip videos/reading, Auto Peer Review & Smart AI Quiz Solver (Gemini, Groq, OpenAI & Zero-Key Mode).",
    "permissions": [
        "activeTab",
        "scripting",
        "declarativeNetRequest",
        "storage",
        "clipboardWrite"
    ],
    "host_permissions": [
        "*://*.coursera.org/*"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.coursera.org/*"
            ],
            "js": [
                "inject.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "*://*.coursera.org/*",
                "*://coursera.org/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}